--- !u!1001 &4301789290397193656
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 3695997404174212714}
    m_Modifications:
    - target: {fileID: 1775895617385630914, guid: 4fa293890e963cf4b828ddc3528de03f, type: 3}
      propertyPath: m_text
      value: "You are Declan Kelly, a twenty-something living in rural Ireland in
        2008, right after the Celtic Tiger collapsed and took every decent job with
        it.\n\nThere\u2019s no solid work around you, Dublin is too expensive, and
        your only real chance is getting to Australia to earn proper money on the
        mines or building sites.\n\nBut you need at least \u20AC5,000 before your
        working visa window closes, so you have put together a rough crew of local
        currach racers to win Sunday races. \n\nYou plan to take a cut from the betting
        money and scrape together enough cash to escape."
      objectReference: {fileID: 0}
    - target: {fileID: 1775895617385630914, guid: 4fa293890e963cf4b828ddc3528de03f, type: 3}
      propertyPath: m_fontSizeMin
