      m_Items: []
  - m_Id: 6728547557376
    m_Localized: "N\xED f\xE9idir leat do bhille {0} a \xEDoc."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809115
  - m_Id: 7080319639552
    m_Localized: "T\xE1 do bhille {0} ar luach \u20AC{1} \xEDoctha agat."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809115
  - m_Id: 7184816529408
    m_Localized: "\xCDocadh do bhille {0} go huathoibr\xEDoch toisc go raibh s\xE9
      10 l\xE1 thar t\xE9arma. Gearradh {1} ort."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809115
  - m_Id: 7582499463168
    m_Localized: "T\xE1 do bhille {0} thar t\xE9arma; is \xE9 {1} an m\xE9id at\xE1
