  m_TableData:
  - m_Id: 622370742272
    m_Localized: "Caithfidh \u20AC{0} ar a laghad a bheith agat chun oili\xFAint
      a dh\xE9anamh."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809130
  - m_Id: 497057521664
    m_Localized: "Caithfidh ar a laghad {0} Fuinneamh a bheith agat chun traen\xE1il
      a dh\xE9anamh."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809130
  - m_Id: 385195433984
    m_Localized: "N\xEDl aon mhionchluiche ar f\xE1il chun {0} a oili\xFAint."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809130
  - m_Id: 13739483136
    m_Localized: "T\xE1 s\xE9 r\xF3-dh\xE9anach traen\xE1il inniu. Bain triail as
      ar\xEDs am\xE1rach."
    m_Metadata:
      m_Items: []
  - m_Id: 300856369152
    m_Localized: "T\xE1 s\xE9 ag \xE9ir\xED d\xE9anach; smaoinigh ar sc\xEDth a ligean
      go luath."
    m_Metadata:
      m_Items: []
