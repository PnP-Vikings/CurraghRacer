  m_TableData:
  - m_Id: 7531913216
    m_Localized: 'You have been invited to participate in\nThe '
    m_Metadata:
      m_Items: []
  - m_Id: 2135222640640
    m_Localized: Tutorial League
    m_Metadata:
      m_Items: []
  - m_Id: 2311697981440
    m_Localized: The Tutorial League a league for learning the ropes
    m_Metadata:
      m_Items: []
  - m_Id: 2416299728896
    m_Localized: Local Racing League
    m_Metadata:
      m_Items: []
  - m_Id: 2965053104128
    m_Localized: "The Local Racing League is the entry-level competition where new
      captains and teams prove their skills on the water.\\n  Featuring 8 determined
      crews, races are held over 8 Sunday race days with a maximum of 4 boats per
      heat.\\n  Each race demands strategy, speed, and adaptability as teams compete
      for points, currency, and experience.\\n \\n   The league is your chance to
      gain promotion. \\nThe top 2 teams at the end of the season rise to higher
      leagues, while the rest will be stuck behind.\\nThe league provides steady
      rewards \u2014 125 coins per race to the winners and 500 coins per season for
      the Champion \u2014\\nmaking it the perfect training ground for ambitious racers
      before moving on to more prestigious competitions."
    m_Metadata:
      m_Items: []
  - m_Id: 3479362854912
    m_Localized: "Accept \nInvitation"
    m_Metadata:
      m_Items: []
  - m_Id: 4628233052160
    m_Localized: Accept
    m_Metadata:
      m_Items: []
