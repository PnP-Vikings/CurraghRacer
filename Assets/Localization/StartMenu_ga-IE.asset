  m_TableData:
  - m_Id: 23927447552
    m_Localized: "Ag fanacht leis an bhf\xF3gra a bheith le feice\xE1il, fan le do
      thoil..."
    m_Metadata:
      m_Items: []
  - m_Id: 72149360640
    m_Localized: "Caithfidh {0} Fuinneamh a bheith agat chun r\xE1s a rith."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809142
  - m_Id: 119310114816
    m_Localized: "N\xED raibh t\xFA in ann \xEDoc as t\xE1ille iontr\xE1la an r\xE1sa
      \u2014 d\u2019\xEDoc an drong duit. T\xE1 fiacha ort anois. \\n M\xC1 BH\xCDONN
      FIACHA {0} ort, BEIDH DEIREADH LEIS AN gCLUICHE!!!"
    m_Metadata:
      m_Items:
      - rid: 7162749194343809142
  - m_Id: 224180297728
    m_Localized: "T\xE1 an t\xE1ille iontr\xE1la {0} \xEDoctha agat."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809142
  - m_Id: 300256583680
    m_Localized: "T\xE1 s\xE9 r\xF3-dh\xE9anach oibri\xFA inniu. Bain triail as ar\xEDs
      am\xE1rach."
    m_Metadata:
      m_Items: []
  - m_Id: 306325741568
    m_Localized: "Caithfidh t\xFA an tasc teagaisc reatha a chur i gcr\xEDch ar dt\xFAs."
    m_Metadata:
      m_Items: []
  - m_Id: 340458987520
    m_Localized: "Caithfidh {0} fuinnimh a bheith agat chun oibri\xFA."
    m_Metadata:
      m_Items:
      - rid: 7162749194343809142
