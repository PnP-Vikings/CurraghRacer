  - m_Id: 743283276898304
    m_Localized: "Ar chl\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 743344094306304
    m_Localized: Ceart go leor
    m_Metadata:
      m_Items: []
  - m_Id: 863024549191680
    m_Localized: "Cuir t\xFAs leis an gcluiche"
    m_Metadata:
      m_Items: []
  - m_Id: 863183932743680
    m_Localized: "Clice\xE1il ar charn chun \xE9 a roghn\xFA.\r\nAnsin br\xFAigh
      an cnaipe cairn chun \xE9 a chasadh.\r\nCas {0} carn ar a laghad sula rachaidh
      an t-am in \xE9ag chun an bua a fh\xE1il!"
    m_Metadata:
      m_Items:
      - rid: 7084867036035678298
  - m_Id: 863249951088640
    m_Localized: Cruach
    m_Metadata:
      m_Items: []
  - m_Id: 863313951973376
    m_Localized: "Cruach Cr\xEDochnaithe X {0}"
    m_Metadata:
      m_Items:
      - rid: 7084867036035678298
  - m_Id: 863697177141248
    m_Localized: Roghnaigh cruach le cur ag bun
    m_Metadata:
      m_Items: []
  - m_Id: 866954834337792
    m_Localized: "Cruach Cr\xEDochnaithe"
    m_Metadata:
      m_Items: []
  - m_Id: 867426764840960
    m_Localized: "T\xE1 an t-am istigh! \\n Comhghairdeas! Chas t\xFA {0} carn! \\n
      Bh\xED ort ar a laghad {1} carn a chasadh chun an bua a fh\xE1il."
    m_Metadata:
      m_Items:
      - rid: 7084867036035678298
  - m_Id: 867472075907072
    m_Localized: "T\xE1 an t-am istigh! \\n D'iompaigh t\xFA {0} carn! \\n Bh\xED
      ort ar a laghad {1} carn a iomp\xFA chun buachan."
    m_Metadata:
      m_Items:
      - rid: 7084867036035678298
  - m_Id: 1067783289823232
    m_Localized: "Pl\xE1ta tumtha!"
    m_Metadata:
      m_Items: []
  - m_Id: 1068051607838720
    m_Localized: "Tum an pl\xE1ta ar\xEDs!"
    m_Metadata:
      m_Items: []
  - m_Id: 1068138169884672
    m_Localized: "Pl\xE1ta\xED sceite..."
    m_Metadata:
      m_Items: []
  - m_Id: 1069485623599104
    m_Localized: "Ag fanacht leis an pl\xE1ta..."
    m_Metadata:
      m_Items: []
  - m_Id: 1069552292061184
    m_Localized: "Tum an pl\xE1ta in uisce..."
    m_Metadata:
      m_Items: []
  - m_Id: 1069607040311296
    m_Localized: "Pl\xE1ta glan..."
    m_Metadata:
      m_Items: []
  - m_Id: 1069642746421248
    m_Localized: "Gach pl\xE1ta glanta!"
    m_Metadata:
      m_Items: []
  - m_Id: 1069854600716288
    m_Localized: "Pl\xE1ta glanta!"
    m_Metadata:
      m_Items: []
  - m_Id: 1074592704618496
    m_Localized: "Svaidhp\xE1il s\xEDos go dt\xED an Pl\xE1ta Tumtha"
    m_Metadata:
      m_Items: []
  - m_Id: 1081469714817024
    m_Localized: Carraig Roghnaithe!
    m_Metadata:
      m_Items: []
  - m_Id: 1082705507770368
    m_Localized: "Scipe\xE1il gach rud"
