  - m_Id: 1101474842009600
    m_Localized: "Roghnaigh an chloch seo chun \xED a \xFAs\xE1id!"
    m_Metadata:
      m_Items: []
  - m_Id: 1101562129670144
    m_Localized: '{0} cloch roghnaithe!'
    m_Metadata:
      m_Items:
      - rid: 7084867036035678298
  - m_Id: 1104360539938816
    m_Localized: Svaip chun caitheamh! \nTreoir = Uillinn,\n Fad = Cumhacht
    m_Metadata:
      m_Items: []
  - m_Id: 1104879954157568
    m_Localized: "Br\xFAigh ar an BEAT le caitheamh"
    m_Metadata:
      m_Items: []
  - m_Id: 1104934735962112
    m_Localized: "Coinnigh chun cumhacht a lucht\xFA\\nSaoirsigh chun caitheamh!"
    m_Metadata:
      m_Items: []
  - m_Id: 1110274315640832
    m_Localized: "Tap\xE1il nuair a bhuaileann an ciorcal an sprioc!"
