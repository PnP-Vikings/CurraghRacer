  m_TableData:
  - m_Id: 49693057024
    m_Localized: "mbaineann s\xE9 leo: {0}"
    m_Metadata:
      m_Items:
      - rid: 7162748853529608284
  - m_Id: 4011775221760
    m_Localized: "Ceannaigh pionta\xED do d'fhoireann"
    m_Metadata:
      m_Items: []
  - m_Id: 4151797866496
    m_Localized: "Ceannaigh pionta\xED do d'fhoireann \u2013 Chuirfidh seo isteach
      ar d'fhoireann ar fad.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4335537741824
    m_Localized: "D\u2019fh\xE9adfadh s\xE9 go gcuirfeadh s\xE9 feabhas ar mheon
      na foirne \u20AC20 a chaitheamh ar pionta\xED do na leaids."
    m_Metadata:
      m_Items: []
  - m_Id: 4464630030336
    m_Localized: "S\xE1bh\xE1il na t-airgead, ach d\u2019fh\xE9adfadh an meanma titim."
    m_Metadata:
      m_Items: []
  - m_Id: 7225027321856
    m_Localized: Iomramhach Tartmhar
    m_Metadata:
      m_Items: []
  - m_Id: 7346154627072
    m_Localized: "A Bhainisteoir, t\xE1 beag\xE1n tart orm; an bhf\xE9adfainn c\xFApla
      t-airgead a fh\xE1il ar iasacht chun rud \xE9igin a cheannach?"
    m_Metadata:
      m_Items: []
  - m_Id: 7412827283456
    m_Localized: "D\u2019fh\xE9adfadh s\xE9 go gcuirfeadh s\xE9 feabhas ar mheon
      do chomhghleacaithe foirne \u20AC20 a chaitheamh ar dheoch a cheannach."
    m_Metadata:
      m_Items: []
  - m_Id: 7515906498560
    m_Localized: "S\xE1bh\xE1il airgead, ach d\u2019fh\xE9adfadh s\xE9 an sonas a
      laghd\xFA."
    m_Metadata:
      m_Items: []
  - m_Id: 8735752708096
    m_Localized: "Bh\xED o\xEDche fhi\xE1in agaibh f\xE9in agus ag an bhfoireann,\nagus
      chodail sibh thar bhur gcuid ama tr\xED thimpiste \u2014 chaill sibh dh\xE1
      uair an chloig den l\xE1.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 8654681006080
    m_Localized: "O\xEDche Fhi\xE1in"
    m_Metadata:
      m_Items: []
  - m_Id: 8793608937472
    m_Localized: "T\xFAs d\xE9anach leis an l\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 8896407134208
    m_Localized: "T\xFAs d\xE9anach leis an l\xE1"
    m_Metadata:
      m_Items: []
